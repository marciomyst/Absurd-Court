{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/*.{js,css,map,png,jpg,jpeg,gif,svg,ico,webp,avif,woff,woff2,ttf}"
    ]
  },
  "globalHeaders": {
    "Cache-Control": "no-cache, max-age=0, must-revalidate",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY"
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/*.{js,css,png,jpg,jpeg,gif,svg,ico,webp,avif,woff,woff2,ttf}",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
